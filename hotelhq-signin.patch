index 4c0e1a6..c95a4ad 100644
--- a/index.html
+++ b/index.html
@@ -989,7 +989,7 @@ const TILES={"Shuttle Driver":["sched","my","shut","line"],"House Person":["sche
 const KEY="jrportal_v7";let MEM={},STORE_OK=true;
