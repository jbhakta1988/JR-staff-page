diff --git a/install.html b/install.html
index 2373293..dcaab21 100644
--- a/install.html
+++ b/install.html
@@ -11,7 +11,7 @@
 body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
 .bar{position:sticky;top:0;z-index:2;display:flex;gap:8px;align-items:center;justify-content:space-between;padding:10px 16px;background:var(--surface);color:var(--ink);border-bottom:1px solid var(--line)}
 .bar a{color:var(--ink);font-weight:800;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
-.bar a span{color:var(--accent)}
+.bar a span{color:#946c00}
 .bar .tools{display:flex;gap:6px}
 .bar button{min-height:44px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-weight:700;padding:6px 12px}
 .bar button.on{background:var(--accent);color:#fff;border-color:var(--accent)}
@@ -19,7 +19,7 @@ body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI"
