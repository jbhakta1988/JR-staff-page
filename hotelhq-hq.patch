 .brand{display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--surface);color:var(--ink);padding:18px 20px;border-bottom:1px solid var(--line)}
 .logo{font-size:32px;font-weight:800;letter-spacing:-.03em;line-height:1}
